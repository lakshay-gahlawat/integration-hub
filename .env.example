# ------------------------------------------------------------------
# Copy this file to .env and fill in real values before running
# `docker-compose up`. Nothing here is a working secret.
# ------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (matches the `db` service in docker-compose.yml) ---
POSTGRES_USER=integration_hub
POSTGRES_PASSWORD=integration_hub
POSTGRES_DB=integration_hub
DATABASE_URL=postgresql+psycopg2://integration_hub:integration_hub@db:5432/integration_hub

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- JWT ---
# Generate a real value with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Integration credential encryption at rest ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key makes previously stored integration tokens
# undecryptable -- users would need to reconnect. Never commit a real value.
INTEGRATION_ENCRYPTION_KEY=

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- GitHub OAuth App (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: openssl rand -hex 20 -- must match the secret configured
# on the GitHub webhook itself.
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/github/oauth/callback

# --- Slack App (https://api.slack.com/apps) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Found on your Slack app's "Basic Information" page ("Signing Secret").
SLACK_SIGNING_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/slack/oauth/callback

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
